      "id": "0588015c-8bfd-49d3-b4c3-1f490584ad83",
      "name": "HTML"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst titles = data.title || [];\nconst companies = data.company || [];\nconst urls = data.url || [];\n\nconst jobs = [];\nfor (let i = 0; i < Math.min(titles.length, 20); i++) {\n  const cleanUrl = (urls[i] || '').split('?')[0];\n  const idMatch = cleanUrl.match(/-(\\d+)$/);\n  jobs.push({\n    id: idMatch ? idMatch[1] : String(100000 + i),\n    title: (titles[i] || '').trim(),\n    company: (companies[i] || '').trim(),\n    url: cleanUrl\n  });\n}\n\nif (jobs.length === 0) {\n  throw new Error('No LinkedIn jobs returned for this query. Try a broader Target Role.');\n}\n\nreturn [{ json: { jobs } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        464
      ],
      "id": "eaba2ad3-136e-46e4-87ee-1bfd26a7533a",
      "name": "Format LinkedIn Jobs"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash-lite",
          "mode": "list",
          "cachedResultName": "Gemini 3.5 Flash Lite"
        },
        "messages": {
          "values": [
            {
              "content": "=Pick the TOP 5 best matching jobs for this candidate from the list below.\nReturn ONLY a raw JSON array of 5 objects with keys: \"job_id\", \"title\", \"company\", \"match_score\", \"reason\", \"url\", \"resume_summary\".\nKeep \"reason\" and \"resume_summary\" under 8 words each with no double quotes.\n\nTarget Role: {{ $('On form submission').item.json.Target_Role }}\nExperience Level: {{ $('On form submission').item.json.Experience_Level }}\nResume: {{ $('Extract from File').item.json.text.slice(0, 1500) }}\nJobs: {{ JSON.stringify($json.jobs) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1328,
        464
      ],
      "id": "38aec71d-0487-4596-80d3-c4ee4e87df4f",
      "name": "AI Job Matcher",
      "credentials": {
        "googlePalmApi": {
          "id": "CNdkql6M3kbNhcNq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet rawText = item.text || item.content?.parts?.[0]?.text || JSON.stringify(item);\n\nrawText = rawText.replace(/```json|```/g, '').trim();\n\nconst matches = [];\nconst objRegex = /\\{[^{}]*\\}/g;\nlet m;\nwhile ((m = objRegex.exec(rawText)) !== null) {\n  try {\n    const parsed = JSON.parse(m[0]);\n    if (parsed.title && parsed.company) {\n      matches.push(parsed);\n    }\n  } catch (e) {\n    // Skip malformed/truncated trailing object\n  }\n}\n\nif (matches.length === 0) {\n  throw new Error('No valid job objects found in AI response: ' + rawText.slice(0, 300));\n}\n\nreturn matches.slice(0, 5).map(job => ({ json: job }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1616,
