    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": ".base-search-card__title",
              "returnArray": true
            },
            {
              "key": "company",
              "cssSelector": ".base-search-card__subtitle",
              "returnArray": true
            },
            {
              "key": "url",
              "cssSelector": "a.base-card__full-link",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            }
          ]
