      "parameters": {
        "url": "=https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords={{ encodeURIComponent($('On form submission').item.json.Target_Role || 'Software Engineer') }}&location=India&f_E={{ $('On form submission').item.json.Experience_Level.includes('Fresher') ? '1%2C2' : ($('On form submission').item.json.Experience_Level.includes('Intermediate') ? '3' : '4') }}&start=0",
